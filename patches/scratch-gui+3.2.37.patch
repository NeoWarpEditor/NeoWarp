+@import "../../css/colors.css";
+@import "../../css/filters.css";
+@import "../../css/default-colors.css";
+
+.modal-content {
+    max-width: 600px;
+    margin-top: 50px;
+}
+
+.body {
+    background: $ui-modal-background;
+    padding: 1.5rem 2.25rem;
+    min-height: 150px;
+    max-height: calc(100vh - 250px);
+    overflow-y: auto;
+}
+
+.setting {
+    display: flex;
+    flex-direction: column;
+    padding: 0.5rem 1rem;
+    margin: 0.25rem 0;
+    border-radius: 8px;
+}
+
+.setting:hover,
+.setting:focus-within {
+    background: $badge-border;
+}
+
+.label {
+    height: 32px;
+    display: flex;
+    flex-direction: row;
+    align-items: center;
+    font-weight: 600;
+}
+
+.setting-input {
+    width: 100%;
+    border: 1px solid $ui-black-transparent;
+    border-radius: 6px;
+    padding: 0.5rem;
+    font-size: inherit;
+    font-family: inherit;
+    box-sizing: border-box;
+}
+
+.file-button {
+    font-family: inherit;
+    font-size: 14px;
+    background-color: $looks-secondary;
+    color: white;
+    border: none;
+    padding: 0.5rem 1rem;
+    margin: 0.25rem 0;
+    border-radius: 8px;
+    cursor: pointer;
+    font-weight: bold;
+    width: fit-content;
+}
+
+.file-button:active,
+.file-button:focus-within {
+    box-shadow: 0 0 0 3px $looks-transparent;
+}
+
+.image-preview {
+    max-width: 80px;
+    max-height: 80px;
+    border-radius: 8px;
+    border: 1px solid $ui-black-transparent;
+    margin: 0.25rem 0;
+}
+
+.checkbox-container {
+    display: flex;
+    align-items: center;
+}
+
+.checkbox {
+    margin-right: 0.5rem;
+    width: 18px;
+    height: 18px;
+    cursor: pointer;
+}
+
+.button-row {
+    display: flex;
+    justify-content: flex-end;
+    margin-top: 1rem;
+    gap: 0.5rem;
+}
+
+.cancel-button {
+    font-family: inherit;
+    font-size: 14px;
+    color: $text-primary;
+    background-color: $ui-white;
+    border: 1px solid $ui-black-transparent;
+    padding: 0.5rem 1rem;
+    border-radius: 8px;
+    cursor: pointer;
+    font-weight: bold;
+}
+
+.save-button {
+    font-family: inherit;
+    font-size: 14px;
+    color: white;
+    background-color: $looks-secondary;
+    border: none;
+    padding: 0.5rem 1rem;
+    border-radius: 8px;
+    cursor: pointer;
+    font-weight: bold;
+}
+
+.save-button:disabled {
+    opacity: 0.5;
+    cursor: auto;
+}
+
+.file-name {
+    font-size: 0.85rem;
+    color: $text-primary;
+    opacity: 0.75;
+    margin: 0.25rem 0;
+}
+
+.warning {
+    padding: 0.5rem 1rem;
+    margin: 0.25rem 0;
+    border-radius: 8px;
+    background: rgba(255, 81, 81, 0.25);
+    border: 1px solid red;
+    font-size: 0.85rem;
+}
diff --git a/node_modules/scratch-gui/src/components/tw-my-extension-modal/my-extension-modal.jsx b/node_modules/scratch-gui/src/components/tw-my-extension-modal/my-extension-modal.jsx
