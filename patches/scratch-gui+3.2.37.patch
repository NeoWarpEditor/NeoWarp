diff --git a/node_modules/scratch-gui/src/lib/tw-fetch-image-from-url.js b/node_modules/scratch-gui/src/lib/tw-fetch-image-from-url.js
new file mode 100644
index 0000000..48cb377
--- /dev/null
+++ b/node_modules/scratch-gui/src/lib/tw-fetch-image-from-url.js
@@ -0,0 +1,90 @@
+/**
+ * Fetch an image from a user-provided URL or local file path and return it
+ * as bytes with the detected Scratch data format (png, jpg, gif, bmp, svg).
+ *
+ * Network images are downloaded through the desktop app's main process when
+ * available (EditorPreload.fetchImage), which bypasses the editor page's
+ * CORS restrictions and Content-Security-Policy, and can also read local
+ * files. URLs without a protocol are assumed to be https. data: URLs are
+ * decoded by the browser itself.
+ *
+ * @param {string} rawUrl URL or file path of the image
+ * @returns {Promise<{bytes: Uint8Array; dataFormat: string}>}
+ */
+export default async function fetchImageFromUrl (rawUrl) {
+    let url = String(rawUrl || '').trim();
+    if (!url) {
+        throw new Error('No URL provided');
+    }
+
+    // Normalize full-width punctuation that Chinese/Japanese input methods
+    // produce (：／．？＃＆＝) and strip all whitespace, neither of which can
+    // appear in a real URL.
+    url = url
+        .replace(/[\u3000\s]+/g, '')
+        .replace(/\uFF1A/g, ':')
+        .replace(/\uFF0F/g, '/')
+        .replace(/\uFF0E/g, '.')
+        .replace(/\uFF1F/g, '?')
+        .replace(/\uFF03/g, '#')
+        .replace(/\uFF06/g, '&')
+        .replace(/\uFF1D/g, '=');
+
+    let bytes;
+    if (/^data:/i.test(url)) {
+        const response = await fetch(url);
+        if (!response.ok) throw new Error(`HTTP ${response.status}`);
+        bytes = new Uint8Array(await response.arrayBuffer());
+    } else {
+        const isFile = /^(?:file:|[a-zA-Z]:[\\/]|\\\\)/i.test(url);
+        if (!isFile) {
+            // "example.com/image.png" should be treated as "https://example.com/image.png",
+            // otherwise fetch() would resolve it against the tw-editor:// page origin.
+            if (!/^[a-zA-Z][a-zA-Z\d+\-.]*:/.test(url)) {
+                url = `https://${url}`;
+            }
+            try {
+                // Fail fast with a clear message instead of an opaque error from IPC.
+                // eslint-disable-next-line no-new
+                new URL(url);
+            } catch (e) {
+                throw new Error(`Invalid URL: ${url}`);
+            }
+        }
+        if (typeof EditorPreload !== 'undefined' && EditorPreload.fetchImage) {
+            bytes = new Uint8Array(await EditorPreload.fetchImage(url));
+        } else {
+            const response = await fetch(url);
+            if (!response.ok) throw new Error(`HTTP ${response.status}`);
+            bytes = new Uint8Array(await response.arrayBuffer());
+        }
+    }
+
+    return {
+        bytes,
+        dataFormat: detectDataFormat(bytes, url)
+    };
+};
+
+/**
+ * Determine the Scratch data format from magic bytes, falling back to the
+ * URL's file extension, defaulting to png.
+ * @param {Uint8Array} bytes image data
+ * @param {string} url URL the data came from
+ * @returns {string} png | jpg | gif | bmp | svg
+ */
+const detectDataFormat = (bytes, url) => {
+    const head = String.fromCharCode.apply(null, bytes.slice(0, 512));
+    if (head.includes('<svg') || /^\s*(<\?xml|<!DOCTYPE)/i.test(head)) {
+        return 'svg';
+    }
+    if (bytes[0] === 0x89 && bytes[1] === 0x50) return 'png';
+    if (bytes[0] === 0xff && bytes[1] === 0xd8) return 'jpg';
+    if (bytes[0] === 0x47 && bytes[1] === 0x49 && bytes[2] === 0x46) return 'gif';
+    if (bytes[0] === 0x42 && bytes[1] === 0x4d) return 'bmp';
+    const match = /\.(svg|jpe?g|gif|bmp|png)(?:[?#]|$)/i.exec(url);
+    if (match) {
+        return match[1].toLowerCase() === 'jpeg' ? 'jpg' : match[1].toLowerCase();
+    }
+    return 'png';
+};
diff --git a/node_modules/scratch-gui/src/lib/tw-my-extensions.js b/node_modules/scratch-gui/src/lib/tw-my-extensions.js
new file mode 100644
index 0000000..1f7ca44
--- /dev/null
+++ b/node_modules/scratch-gui/src/lib/tw-my-extensions.js
@@ -0,0 +1,162 @@
+/**
+ * Utility for managing the user's custom "My Extensions" and pinned extensions.
+ * Stored in localStorage.
+ */
+
+const MY_EXTENSIONS_KEY = 'tw:my-extensions';
+const PINNED_EXTENSIONS_KEY = 'tw:pinned-extensions';
+
+let listeners = [];
+let pinnedListeners = [];
+
+const notifyListeners = () => {
+    listeners.forEach(fn => fn());
+};
+
+const notifyPinnedListeners = () => {
+    pinnedListeners.forEach(fn => fn());
+};
+
+/**
+ * @returns {Array} Array of my extension objects:
+ *   { id, name, iconURL, extensionURL, unsandboxed }
+ */
+const getMyExtensions = () => {
+    try {
+        const data = JSON.parse(localStorage.getItem(MY_EXTENSIONS_KEY));
+        if (Array.isArray(data)) return data;
+    } catch (e) {
+        // ignore
+    }
+    return [];
+};
+
+const saveMyExtensions = extensions => {
+    try {
+        localStorage.setItem(MY_EXTENSIONS_KEY, JSON.stringify(extensions));
+        notifyListeners();
+    } catch (e) {
+        // ignore
+    }
+};
+
+const addMyExtension = extension => {
+    const extensions = getMyExtensions();
+    extensions.push(extension);
+    saveMyExtensions(extensions);
+};
+
+const updateMyExtension = (id, updates) => {
+    const extensions = getMyExtensions();
+    const index = extensions.findIndex(ext => ext.id === id);
+    if (index !== -1) {
+        extensions[index] = { ...extensions[index], ...updates };
+        saveMyExtensions(extensions);
+    }
+};
+
+const removeMyExtension = id => {
+    const extensions = getMyExtensions().filter(ext => ext.id !== id);
+    saveMyExtensions(extensions);
+    // Also remove from pinned
+    unpinExtension(id);
+};
+
+const getMyExtensionById = id => {
+    return getMyExtensions().find(ext => ext.id === id);
+};
+
+/**
+ * @returns {Array} Array of my extension objects that should be auto-added to new projects.
+ *   Each item: { id, name, iconURL, extensionURL, unsandboxed, autoAddToNewProjects }
+ */
+const getAutoAddExtensions = () => {
+    return getMyExtensions().filter(ext => ext && ext.autoAddToNewProjects);
+};
+
+// --- Pinned extensions ---
+
+/**
+ * @returns {Array} Array of extension IDs that are pinned to the top.
+ */
+const getPinnedExtensions = () => {
+    try {
+        const data = JSON.parse(localStorage.getItem(PINNED_EXTENSIONS_KEY));
+        if (Array.isArray(data)) return data;
+    } catch (e) {
+        // ignore
+    }
+    return [];
+};
+
+const savePinnedExtensions = pinned => {
+    try {
+        localStorage.setItem(PINNED_EXTENSIONS_KEY, JSON.stringify(pinned));
+        notifyPinnedListeners();
+    } catch (e) {
+        // ignore
+    }
+};
+
+const isPinned = id => getPinnedExtensions().includes(id);
+
+const pinExtension = id => {
+    const pinned = getPinnedExtensions();
+    if (!pinned.includes(id)) {
+        pinned.push(id);
+        savePinnedExtensions(pinned);
+    }
+};
+
+const unpinExtension = id => {
+    const pinned = getPinnedExtensions().filter(p => p !== id);
+    savePinnedExtensions(pinned);
+};
+
+const togglePin = id => {
+    if (isPinned(id)) {
+        unpinExtension(id);
+    } else {
+        pinExtension(id);
+    }
+};
+
+// --- Subscription ---
+
+const onMyExtensionsChange = fn => {
+    listeners.push(fn);
+    return () => {
+        listeners = listeners.filter(f => f !== fn);
+    };
+};
+
+const onPinnedChange = fn => {
+    pinnedListeners.push(fn);
+    return () => {
+        pinnedListeners = pinnedListeners.filter(f => f !== fn);
+    };
+};
+
+/**
+ * Generate a unique ID for a new extension.
+ */
+const generateId = () => {
+    return `my_ext_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
+};
+
+export {
+    getMyExtensions,
+    addMyExtension,
+    updateMyExtension,
+    removeMyExtension,
+    getMyExtensionById,
+    getAutoAddExtensions,
+    getPinnedExtensions,
+    isPinned,
+    pinExtension,
+    unpinExtension,
+    togglePin,
+    onMyExtensionsChange,
+    onPinnedChange,
+    generateId
+};
diff --git a/node_modules/scratch-gui/src/lib/tw-neowarp-extensions.js b/node_modules/scratch-gui/src/lib/tw-neowarp-extensions.js
new file mode 100644
index 0000000..b59306e
--- /dev/null
+++ b/node_modules/scratch-gui/src/lib/tw-neowarp-extensions.js
@@ -0,0 +1,55 @@
+/**
+ * NeoWarp: 从本地 Expands 目录读取扩展（扩展库 NeoWarp 标签的数据源）。
+ *
+ * 目录格式（由主进程 src-main/neowarp-expands.js 扫描）：
+ *   Expands/<扩展名>/<作者>/<简介>/*.js
+ *   Expands/<扩展名>/<图片>          → 扩展 Logo（inset 小图标）
+ *   Expands/<扩展名>/<作者>/<图片>    → 扩展大图（featured 卡片背景）
+ *
+ * 元数据与 nw-expands:// 文件 URL 由主进程通过 IPC 提供，
+ * 这里只负责映射为扩展库条目。失败时返回空列表（标签为空但不报错）。
+ */
+
+// NeoWarp: 当扩展既没有背景大图也没有 Logo 时，iconURL 为 null，
+// 直接交给 <img src={null}> 会渲染成浏览器自带的“裂图”占位（看起来像 :( 暂无背景图）。
+// 这里用一个简洁的内联 SVG 占位图兜底，保证卡片始终显示干净的图标而非裂图。
+const NEOWARP_PLACEHOLDER_ICON = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(
+    '<svg xmlns="http://www.w3.org/2000/svg" width="160" height="160" viewBox="0 0 160 160">' +
+    '<rect width="160" height="160" rx="80" fill="#3a3f4b"/>' +
+    '<g fill="none" stroke="#9aa3b2" stroke-width="6" stroke-linecap="round">' +
+    '<circle cx="80" cy="68" r="26"/>' +
+    '<path d="M40 132 Q80 100 120 132"/>' +
+    '</g></svg>'
+);
+
+const fetchNeowarpExtensions = async () => {
+    if (typeof window === 'undefined' ||
+        !window.EditorPreload ||
+        !window.EditorPreload.getNeowarpExpands) {
+        return [];
+    }
+    let rawItems;
+    try {
+        rawItems = await window.EditorPreload.getNeowarpExpands();
+    } catch (error) {
+        // eslint-disable-next-line no-console
+        console.warn('[neowarp-expands] failed to load local extensions', error);
+        return [];
+    }
+    if (!Array.isArray(rawItems)) return [];
+    return rawItems.map(item => ({
+        name: item.name,
+        extensionId: item.extensionId,
+        extensionURL: item.extensionURL,
+        // featured 卡片大图；无背景图且无 Logo 时回落到内联占位图标，避免裂图
+        iconURL: item.iconURL || NEOWARP_PLACEHOLDER_ICON,
+        // Logo 小图标（无图时为 null，卡片不显示 inset）
+        insetIconURL: item.insetIconURL,
+        description: item.description || '',
+        credits: item.author ? [item.author] : null,
+        tags: ['neowarp'],
+        featured: true
+    }));
+};
+
+export default fetchNeowarpExtensions;
