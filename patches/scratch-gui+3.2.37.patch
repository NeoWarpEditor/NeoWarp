@@ -0,0 +1,259 @@
+import PropTypes from 'prop-types';
+import React from 'react';
+import bindAll from 'lodash.bindall';
+import Box from '../box/box.jsx';
+import Modal from '../../containers/modal.jsx';
+import styles from './my-extension-modal.css';
+
+/**
+ * Read a Blob as a data URL.
+ * @param {Blob} blob
+ * @returns {Promise<string>} data: uri
+ */
+const readAsDataURL = blob => new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve(reader.result);
+    reader.onerror = () => reject(new Error(`Could not read file as data URL: ${reader.error}`));
+    reader.readAsDataURL(blob);
+});
+
+class MyExtensionModal extends React.Component {
+    constructor (props) {
+        super(props);
+        bindAll(this, [
+            'handleClose',
+            'handleSave',
+            'handleNameChange',
+            'handleExtensionFileClick',
+            'handleImageFileClick',
+            'handleUnsandboxedChange',
+            'handleAutoAddChange'
+        ]);
+        const editing = props.editExtension;
+        this.state = {
+            name: editing ? editing.name : '',
+            extensionURL: editing ? editing.extensionURL : '',
+            extensionFileName: editing ? (editing.extensionFileName || '') : '',
+            iconURL: editing ? editing.iconURL : '',
+            unsandboxed: editing ? editing.unsandboxed : false,
+            autoAddToNewProjects: editing ? !!editing.autoAddToNewProjects : false
+        };
+    }
+
+    handleClose () {
+        this.props.onClose();
+    }
+
+    async handleSave () {
+        const data = {
+            name: this.state.name,
+            extensionURL: this.state.extensionURL,
+            extensionFileName: this.state.extensionFileName,
+            iconURL: this.state.iconURL,
+            unsandboxed: this.state.unsandboxed,
+            autoAddToNewProjects: this.state.autoAddToNewProjects
+        };
+        this.props.onSave(data);
+    }
+
+    handleNameChange (e) {
+        this.setState({name: e.target.value});
+    }
+
+    handleUnsandboxedChange (e) {
+        this.setState({unsandboxed: e.target.checked});
+    }
+
+    handleAutoAddChange (e) {
+        this.setState({autoAddToNewProjects: e.target.checked});
+    }
+
+    async handleExtensionFileClick () {
+        const input = document.createElement('input');
+        input.type = 'file';
+        input.accept = '.js';
+        input.onchange = async e => {
+            const file = e.target.files[0];
+            if (file) {
+                try {
+                    const dataURL = await readAsDataURL(file);
+                    this.setState({
+                        extensionURL: dataURL,
+                        extensionFileName: file.name
+                    });
+                    // Auto-fill name if empty
+                    if (!this.state.name) {
+                        const baseName = file.name.replace(/\.js$/i, '');
+                        this.setState({name: baseName});
+                    }
+                } catch (err) {
+                    // eslint-disable-next-line no-alert
+                    alert(err);
+                }
+            }
+        };
+        input.click();
+    }
+
+    async handleImageFileClick () {
+        const input = document.createElement('input');
+        input.type = 'file';
+        input.accept = 'image/*';
+        input.onchange = async e => {
+            const file = e.target.files[0];
+            if (file) {
+                try {
+                    const dataURL = await readAsDataURL(file);
+                    this.setState({iconURL: dataURL});
+                } catch (err) {
+                    // eslint-disable-next-line no-alert
+                    alert(err);
+                }
+            }
+        };
+        input.click();
+    }
+
+    canSave () {
+        return !!(this.state.name && this.state.extensionURL);
+    }
+
+    render () {
+        const isEditing = !!this.props.editExtension;
+        return (
+            <Modal
+                className={styles.modalContent}
+                onRequestClose={this.handleClose}
+                contentLabel={isEditing ? '编辑我的扩展' : '添加我的扩展'}
+                id="myExtensionModal"
+            >
+                <Box className={styles.body}>
+                    {/* 打开扩展 - Open extension file */}
+                    <div className={styles.setting}>
+                        <div className={styles.label}>
+                            打开扩展
+                        </div>
+                        <button
+                            className={styles.fileButton}
+                            onClick={this.handleExtensionFileClick}
+                        >
+                            {this.state.extensionFileName ? '重新选择' : '选择扩展文件'}
+                        </button>
+                        {this.state.extensionFileName && (
+                            <div className={styles.fileName}>
+                                {this.state.extensionFileName}
+                            </div>
+                        )}
+                    </div>
+
+                    {/* 编辑扩展名 - Edit extension name */}
+                    <div className={styles.setting}>
+                        <div className={styles.label}>
+                            编辑扩展名
+                        </div>
+                        <input
+                            type="text"
+                            className={styles.settingInput}
+                            value={this.state.name}
+                            onChange={this.handleNameChange}
+                            placeholder="输入扩展名称"
+                        />
+                    </div>
+
+                    {/* 扩展图片 - Extension image */}
+                    <div className={styles.setting}>
+                        <div className={styles.label}>
+                            扩展图片
+                        </div>
+                        {this.state.iconURL && (
+                            <img
+                                src={this.state.iconURL}
+                                alt="扩展图标"
+                                className={styles.imagePreview}
+                            />
+                        )}
+                        <button
+                            className={styles.fileButton}
+                            onClick={this.handleImageFileClick}
+                        >
+                            {this.state.iconURL ? '重新选择图片' : '选择图片'}
+                        </button>
+                    </div>
+
+                    {/* 是否允许不在沙盒内运行 - Whether to allow running without sandbox */}
+                    <div className={styles.setting}>
+                        <label className={styles.checkboxContainer}>
+                            <input
+                                type="checkbox"
+                                className={styles.checkbox}
+                                checked={this.state.unsandboxed}
+                                onChange={this.handleUnsandboxedChange}
+                            />
+                            <span className={styles.label}>
+                                是否允许不在沙盒内运行
+                            </span>
+                        </label>
+                        {this.state.unsandboxed && (
+                            <div className={styles.warning}>
+                                允许扩展脱离沙盒运行是危险的，如果你不知道自己在做什么，请勿启用此选项。
+                            </div>
+                        )}
+                    </div>
+
+                    {/* 自动添加到新项目 - Auto add to new projects */}
+                    <div className={styles.setting}>
+                        <label className={styles.checkboxContainer}>
+                            <input
+                                type="checkbox"
+                                className={styles.checkbox}
+                                checked={this.state.autoAddToNewProjects}
+                                onChange={this.handleAutoAddChange}
+                            />
+                            <span className={styles.label}>
+                                自动添加到新项目
+                            </span>
+                        </label>
+                        {this.state.autoAddToNewProjects && (
+                            <div className={styles.warning}>
+                                勾选后，每新建一个项目都会自动加载此扩展。
+                            </div>
+                        )}
+                    </div>
+
+                    {/* 添加 / 保存 button */}
+                    <div className={styles.buttonRow}>
+                        <button
+                            className={styles.cancelButton}
+                            onClick={this.handleClose}
+                        >
+                            取消
+                        </button>
+                        <button
+                            className={styles.saveButton}
+                            onClick={this.handleSave}
+                            disabled={!this.canSave()}
+                        >
+                            {isEditing ? '保存' : '添加'}
+                        </button>
+                    </div>
+                </Box>
+            </Modal>
+        );
+    }
+}
+
+MyExtensionModal.propTypes = {
+    editExtension: PropTypes.shape({
+        id: PropTypes.string,
+        name: PropTypes.string,
+        extensionURL: PropTypes.string,
+        extensionFileName: PropTypes.string,
+        iconURL: PropTypes.string,
+        unsandboxed: PropTypes.bool,
+        autoAddToNewProjects: PropTypes.bool
+    }),
+    onSave: PropTypes.func.isRequired,
+    onClose: PropTypes.func.isRequired
+};
+
+export default MyExtensionModal;
